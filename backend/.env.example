# Copy to .env and adjust. All values have sensible dev defaults.
PORT=8080
DB_PATH=portfolio.db
JWT_SECRET=dev-secret-change-me
FRONTEND_ORIGIN=http://localhost:3000
COOKIE_SECURE=false

# Seeded on first run (only used when the users table is empty).
ADMIN_EMAIL=admin@satrianusa.dev
ADMIN_PASSWORD=admin1234

# AI features (Ask AI + Tailored CV). Leave ANTHROPIC_API_KEY unset to use the
# keyword stub; set it to enable real Claude answers.
# ANTHROPIC_API_KEY=sk-ant-...
# AI_MODEL=claude-opus-5   # default; e.g. claude-haiku-4-5 for cheaper/faster
