# Production env for the VPS.
# Copy to `.env` next to docker-compose.yml and fill in real values.
# The real `.env` is git-ignored — never commit it.

# --- Image source (must be lowercase; matches what CI pushes to GHCR) --------
IMAGE_PREFIX=ghcr.io/satriaapn/my-portofolio
# The deploy job overrides this with the commit SHA; `latest` is the fallback
# for a manual `docker compose up` on the box.
IMAGE_TAG=latest

# --- Backend -----------------------------------------------------------------
# Generate with:  openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string
# Secure cookie requires HTTPS (Caddy provides it). Keep true in production.
COOKIE_SECURE=true
FRONTEND_ORIGIN=https://satria-apn.com

# Seeded ONLY on the first boot, while the users table is empty. Set a real
# password here before the very first deploy.
ADMIN_EMAIL=admin@satria-apn.com
ADMIN_PASSWORD=change-me-before-first-boot

# --- AI (optional) -----------------------------------------------------------
# Leave unset to use the keyword stub (no key needed).
# ANTHROPIC_API_KEY=sk-ant-...
# AI_MODEL=claude-opus-5
